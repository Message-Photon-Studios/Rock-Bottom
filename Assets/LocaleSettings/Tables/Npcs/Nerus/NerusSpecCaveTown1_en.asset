  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NerusSpecCaveTown1_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 4de5aee7836c8824684b604ba3ae77e7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6216749056
    m_Localized: Greetings adventurer!
    m_Metadata:
      m_Items: []
  - m_Id: 8536199168
    m_Localized: I am Nerus the Moth, and you are welcome here to my home.
    m_Metadata:
      m_Items: []
  - m_Id: 11468017664
    m_Localized: I was once an explorer,  just like you, travelling around the caves
      collecting items and finding secrets together with my sister Azula.
    m_Metadata:
      m_Items: []
  - m_Id: 13380620288
    m_Localized: But, that was some time ago.
    m_Metadata:
      m_Items: []
  - m_Id: 17168076800
    m_Localized: During our last adventure together I had a terrible accident.
    m_Metadata:
      m_Items: []
  - m_Id: 21358186496
    m_Localized: I fell into a hole, everything went black. The next thing I remembered
      was waking up with a broken wing and my sister gone.
    m_Metadata:
      m_Items: []
  - m_Id: 22629060608
    m_Localized: The only lucky thing was that this ancient chest that we found fell
      into the hole with me.
    m_Metadata:
      m_Items: []
  - m_Id: 23614722048
    m_Localized: However, I cannot open the chest. It is locked with a magic zeal
      that only ancient petrified pigments can open.
    m_Metadata:
      m_Items: []
  - m_Id: 24696852480
    m_Localized: I remember seeing some of the pigments during my adventures, but
      since the accident Lila the doctor has prohibited me from venturing out.
    m_Metadata:
      m_Items: []
  - m_Id: 25514741760
    m_Localized: If you find any of the petrified pigments, or find signs of my sister
      Azula who is still gone, please let me know.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
