  m_TableData:
  - m_Id: 76123213824
    m_Localized: Close Tips
    m_Metadata:
      m_Items: []
  - m_Id: 1185143328768
    m_Localized: 'Each spell you cast has a power level that affects its damage and
      the efficiency of the color effects. The power of the spell is displayed under
      the spell bottle and in the inventory.

'
    m_Metadata:
      m_Items: []
  - m_Id: 1236594855936
    m_Localized: "Each bottle that is filled to the maximum will power up the color
      it is filled with for all bottles.  \n"
    m_Metadata:
      m_Items: []
  - m_Id: 1288570671104
    m_Localized: 'Enemies take less damage from spells with the same color as them.

'
    m_Metadata:
      m_Items: []
  - m_Id: 1331147051008
    m_Localized: "Enemies colored to the rainbow color are unstable for a short time
      and will therefore be executed when falling under 20% health. Executed enemies
      drop color that refill your bottles. \n"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
