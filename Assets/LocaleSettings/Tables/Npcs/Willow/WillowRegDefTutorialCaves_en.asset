  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: WillowRegDefTutorialCaves_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 8275dc111bc5bd84d85e5ab6e6aad890, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9466712064
    m_Localized: Nice to meet you! I'm Willow Worm.
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563008
    m_Localized: These old caves can be a bit tricky to navigate, at least for non-worm
      beings like yourself. But do not worry!
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563009
    m_Localized: 'There is a door just above here that you could use, as long as
      you have the key.  Like the one I have right here. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563010
    m_Localized: 'Unfortunately, it took a lot of effort for me to find it. We are
      living in trying times, I can''t be giving away keys for free. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563011
    m_Localized: 'How about you get me something in return. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563012
    m_Localized: The living stones walking around, have you seen them? They carry
      a weird pigment from outer space. I call them "Astral Pigments".
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563013
    m_Localized: 'Collect some of these Astral Pigments for me, and the key will
      be yours. '
    m_Metadata:
      m_Items: []
  - m_Id: 136622129545383936
    m_Localized: 'What I will use them for? Well- don''t worry to much about it for
      now. '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
