  m_SharedData: {fileID: 11400000, guid: e0b70eb27842dac4993a71443e779a8b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10322972672
    m_Localized: Little Squirrel.
    m_Metadata:
      m_Items: []
  - m_Id: 143796463619706880
    m_Localized: 'Are you taking good care of yourself? A healthy adventurer gives
      me less work. '
    m_Metadata:
      m_Items: []
  - m_Id: 143796540547436544
    m_Localized: 'Did you see the shrine downstairs? A source of magic. It can make
      you sturdier, give you more health. '
    m_Metadata:
      m_Items: []
  - m_Id: 143796586319876096
    m_Localized: 'It''s an heirloom from my ancestors, some of the greatest doctors
      of all time. '
    m_Metadata:
      m_Items: []
  - m_Id: 143796615709364224
    m_Localized: Some are said to have "healed" beings back from only a few bones. 
      A level of healing a leech like myself can only dream of.
    m_Metadata:
      m_Items: []
  - m_Id: 143796676883288064
    m_Localized: That shrine is not the only one, I have heard that there are others
      across the caves around here.
    m_Metadata:
      m_Items: []
  - m_Id: 143796736635342848
    m_Localized: ' If you get too scratched up, give them a visit. '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
