  m_TableData:
  - m_Id: 73073954816
    m_Localized: 'Are you alright, Squirrel? '
    m_Metadata:
      m_Items: []
  - m_Id: 143797088076075008
    m_Localized: I am Lila, the greatest, and only, doctor around.
    m_Metadata:
      m_Items: []
  - m_Id: 143797107613143040
    m_Localized: 'When you were brought back from the caves, you had a few scratches
      I had to patched up. '
    m_Metadata:
      m_Items: []
  - m_Id: 143797191704743936
    m_Localized: 'We live in dangerous times now, but I will be here to fix you right
      up whenever you need it. '
    m_Metadata:
      m_Items: []
