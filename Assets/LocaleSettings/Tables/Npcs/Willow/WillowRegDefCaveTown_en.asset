  m_TableData:
  - m_Id: 46427541504
    m_Localized: Oh great, you're awake. You collapsed in one of the caves.
    m_Metadata:
      m_Items: []
  - m_Id: 103503630336
    m_Localized: 'Good thing a good hearted worm like me was passing by and found
      you. '
    m_Metadata:
      m_Items: []
  - m_Id: 109853806592
    m_Localized: 'I managed to bring you back here, but unfortunately I couldn''t
      take any of your items with me. '
    m_Metadata:
      m_Items: []
  - m_Id: 115277041664
    m_Localized: No idea what happened to them.
    m_Metadata:
      m_Items: []
  - m_Id: 133627121664
    m_Localized: 'None. At all. '
    m_Metadata:
      m_Items: []
  - m_Id: 143846836799705088
    m_Localized: I have no hands to carry them, being a worm and all. Hahaha.
    m_Metadata:
      m_Items: []
