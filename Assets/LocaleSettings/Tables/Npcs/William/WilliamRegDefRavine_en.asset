  m_TableData:
  - m_Id: 46833766400
    m_Localized: Oh, Hi.
    m_Metadata:
      m_Items: []
  - m_Id: 105449164800
    m_Localized: Willow, my sister, told me to repair some more bottles for you.
    m_Metadata:
      m_Items: []
  - m_Id: 129180536832
    m_Localized: 'I.. would never fail her request! '
    m_Metadata:
      m_Items: []
  - m_Id: 155667566592
    m_Localized: 'Even though she can be a bit demanding. '
    m_Metadata:
      m_Items: []
  - m_Id: 191516282880
    m_Localized: 'She also told me to tell you that you could not have the bottles
      for free. '
    m_Metadata:
      m_Items: []
  - m_Id: 273003220992
    m_Localized: I do not know why... I always work for free and would happily help
      you without payment.
    m_Metadata:
      m_Items: []
  - m_Id: 322839941120
    m_Localized: But... I would never question my sister!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
