  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: AzulaSpecTheOutskirts1_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 879590b4a9b091248bacc55c47644a85, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8187449344
    m_Localized: Oh hi, who are you and why are you disturbing my studies?
    m_Metadata:
      m_Items: []
  - m_Id: 19637899264
    m_Localized: 'Nerus sent you? Ok, well good to know that he has recovered and
      is safe. '
    m_Metadata:
      m_Items: []
  - m_Id: 26646581248
    m_Localized: I am afraid to  admit that I have been a bit worried about him...
      but that could not distract me from investigating these old shrines.
    m_Metadata:
      m_Items: []
  - m_Id: 35265875968
    m_Localized: 'They seem to be sealing ancient spell bottles inside them. But
      to be able to release them again I require petrified pigment. '
    m_Metadata:
      m_Items: []
  - m_Id: 44271046656
    m_Localized: 'If you find petrified pigments please offer them to the shrines
      so we can examine them further. '
    m_Metadata:
      m_Items: []
  - m_Id: 50298261504
    m_Localized: Oh, about Nerus? Well just tell him that I will be back when I am
      done with the investigation.
    m_Metadata:
      m_Items: []
  - m_Id: 55964766208
    m_Localized: 'The investigation is more important than returning home. '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
