  m_Name: WillowRegDefTutorialCaves_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 8275dc111bc5bd84d85e5ab6e6aad890, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9466712064
    m_Localized: Hello there! My name is Willow Worm.
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563008
    m_Localized: I see that you have found yourself stuck in these old caves. Well
      that is unfortunate, for you.
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563009
    m_Localized: 'To be able to proceed through the door here above you would need
      a key.  Well, lucky for you that I found one. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563010
    m_Localized: I would consider giving it to you, but it took a lot of effort to
      find it. So I can give it to you if you also give a gift to me.
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563011
    m_Localized: 'Have you seen these living stones walking around, they contain
      a weird pigment type that seems to come from outer space. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563012
    m_Localized: 'If you go and collect some of these Astral Pigments for me then
      I will give you the key, as a trade of sorts. '
    m_Metadata:
      m_Items: []
  - m_Id: 5088395563013
    m_Localized: Oh, you wonder what I need the astral pigments for, well that is
      none of your concern.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
