  m_TableData:
  - m_Id: 12499193856
    m_Localized: Oh, Hi again.
    m_Metadata:
      m_Items: []
  - m_Id: 45848104960
    m_Localized: Weird things have started to happen here in the caves...
    m_Metadata:
      m_Items: []
  - m_Id: 74222571520
    m_Localized: More and more different types of bottles have started to appear!
    m_Metadata:
      m_Items: []
  - m_Id: 105872789504
    m_Localized: I do not know what is happening... and that is scary.
    m_Metadata:
      m_Items: []
  - m_Id: 137061634048
    m_Localized: But, I should not worry. Willow will protect me.
    m_Metadata:
      m_Items: []
  - m_Id: 165650010112
    m_Localized: She always does.
