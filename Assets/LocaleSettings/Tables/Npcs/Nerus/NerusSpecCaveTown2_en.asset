  m_SharedData: {fileID: 11400000, guid: 6eb3c5970e8545a44b5871e396b8a647, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 36373172224
    m_Localized: You managed to unlock the chest!
    m_Metadata:
      m_Items: []
  - m_Id: 54207352832
    m_Localized: I am forever greatful! However, it seems like the chest contained
      a key, and you know what that means...
    m_Metadata:
      m_Items: []
  - m_Id: 104207650816
    m_Localized: 'If there is a key, then there needs to be a lock somewhere. '
    m_Metadata:
      m_Items: []
  - m_Id: 130145226752
    m_Localized: Problem is, I am still not capable of adventuring. So may I ask
      you for another request?
    m_Metadata:
      m_Items: []
  - m_Id: 165863919616
    m_Localized: 'Could you find the lock to the key? '
    m_Metadata:
      m_Items: []
  - m_Id: 227910258688
    m_Localized: I am sure it can't be too far away from here as we found the chest
      in the abandoned outskirts of the town just on the way up from here.
    m_Metadata:
      m_Items: []
  - m_Id: 292825501696
    m_Localized: 'Also in favor, I will make sure that that greedy worm does not
      lay its hands on the key if you would ever be "rescued" by her again. '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
